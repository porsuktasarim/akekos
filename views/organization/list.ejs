<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<div id="main">
  <%- include('../partials/topbar') %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <p class="text-muted mb-0 small"><%= t.org_tree_hint %></p>
      <a href="/organization/new" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i><%= t.new_record %>
      </a>
    </div>

    <div class="card p-3">
      <% if (!tree.length) { %>
        <div class="text-center text-muted py-4">
          <i class="fas fa-sitemap fa-2x mb-2 d-block opacity-25"></i>
          <%= t.org_empty %>
        </div>
      <% } else { %>
        <ul class="org-tree list-unstyled mb-0">
          <%- include('./partial_tree', { nodes: tree, depth: 0 }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
