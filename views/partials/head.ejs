<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= baslik %> — AKEKOS</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root { --sidebar-w: 240px; --brand: #1F3D7A; --brand-dark: #162d5e; }
    body { background: #f4f6f9; }
    #sidebar {
      width: var(--sidebar-w); min-height: 100vh; background: var(--brand);
      position: fixed; top: 0; left: 0; z-index: 100; display: flex; flex-direction: column;
    }
    #sidebar .brand { background: var(--brand-dark); padding: 1rem 1.25rem; color: #fff; font-weight: 700; font-size: 1.1rem; }
    #sidebar .nav-link { color: rgba(255,255,255,.75); padding: .5rem 1.25rem; font-size: .9rem; border-radius: 0; }
    #sidebar .nav-link:hover, #sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,.1); }
    #sidebar .nav-link i { width: 20px; }
    #sidebar .nav-section { color: rgba(255,255,255,.4); font-size: .7rem; text-transform: uppercase;
      letter-spacing: .08em; padding: .75rem 1.25rem .25rem; }
    #main { margin-left: var(--sidebar-w); min-height: 100vh; }
    #topbar { background: #fff; border-bottom: 1px solid #e3e6ea; padding: .6rem 1.5rem;
      display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 99; }
    .content { padding: 1.5rem; }
    .card { border: none; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
    .stat-card { border-left: 4px solid var(--brand); }
    .table th { background: #f8f9fa; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; }
    .badge-aktif   { background: #d1fae5; color: #065f46; }
    .badge-pasif   { background: #fee2e2; color: #991b1b; }
  </style>
</head>
<body>
