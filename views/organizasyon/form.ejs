<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<div id="main">
  <%- include('../partials/topbar') %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <div class="card p-4" style="max-width:680px">
      <h5 class="mb-4"><%= baslik %></h5>

      <form action="<%= org ? '/organizasyon/' + org._id + '?_method=PUT' : '/organizasyon' %>" method="POST" id="orgForm">

        <div class="row g-3">

          <!-- Kademe (yeni kayıtta seçilir, düzenlemede gösterilir sadece) -->
          <div class="col-md-6">
            <label class="form-label fw-semibold">Kademe <span class="text-danger">*</span></label>
            <% if (org) { %>
              <input type="text" class="form-control" readonly value="<%= KADEME_ETIKET[org.kademe] %>">
              <small class="text-muted">Kademe değiştirilemez.</small>
            <% } else { %>
              <select name="kademe" id="kademeSec" class="form-select" required>
                <option value="">— Seçin —</option>
                <% KADEME.forEach(k => { %>
                  <option value="<%= k %>" <%= seciliKademe === k ? 'selected' : '' %>><%= KADEME_ETIKET[k] %></option>
                <% }) %>
              </select>
            <% } %>
          </div>

          <!-- Üst birim -->
          <div class="col-md-6" id="ustRow">
            <label class="form-label fw-semibold">
              Üst Birim
              <% if (seciliKademe && seciliKademe !== 'bakanlik') { %><span class="text-danger">*</span><% } %>
            </label>
            <select name="ust" id="ustSec" class="form-select"
              <%= (seciliKademe && seciliKademe !== 'bakanlik') ? 'required' : '' %>>
              <option value="">— Seçin —</option>
              <% ustlar.forEach(u => { %>
                <option value="<%= u._id %>"
                  <%= (seciliUst && seciliUst.toString() === u._id.toString()) ? 'selected' : '' %>>
                  <%= u.ad %><%= u.merkezIl ? ' (' + u.merkezIl + ')' : '' %><%= u.slug ? ' [' + u.slug + ']' : '' %>
                </option>
              <% }) %>
            </select>
          </div>

          <!-- Ad -->
          <div class="col-12">
            <label class="form-label fw-semibold">Ad <span class="text-danger">*</span></label>
            <input type="text" name="ad" class="form-control" required
                   value="<%= org ? org.ad : '' %>" placeholder="Birim adı">
          </div>

          <!-- Merkez İl -->
          <%
            const merkezIlZorunlu = ['il_bolge','ake','alt_birim'].includes(seciliKademe || (org && org.kademe));
            const merkezIlSecili  = (org && org.merkezIl) || '';
          %>
          <div class="col-md-6" id="merkezIlRow">
            <label class="form-label fw-semibold">
              Merkez Adres İli
              <% if (merkezIlZorunlu) { %><span class="text-danger">*</span><% } %>
            </label>
            <select name="merkezIl" id="merkezIlSec" class="form-select"
              <%= merkezIlZorunlu ? 'required' : '' %>>
              <option value="">— Seçin —</option>
              <% Object.keys(IL_KODLARI).sort().forEach(il => { %>
                <option value="<%= il %>" <%= merkezIlSecili === il ? 'selected' : '' %>><%= il %></option>
              <% }) %>
            </select>
            <small class="text-muted">İl plaka kodunu belirler; AKE slug'ında kullanılır.</small>
          </div>

          <!-- Telefon -->
          <div class="col-md-6">
            <label class="form-label">Telefon</label>
            <input type="text" name="telefon" class="form-control"
                   value="<%= org ? (org.telefon||'') : '' %>">
          </div>

          <!-- E-posta -->
          <div class="col-md-6">
            <label class="form-label">E-posta</label>
            <input type="email" name="email" class="form-control"
                   value="<%= org ? (org.email||'') : '' %>">
          </div>

          <!-- Adres -->
          <div class="col-12">
            <label class="form-label">Adres</label>
            <textarea name="adres" class="form-control" rows="2"><%= org ? (org.adres||'') : '' %></textarea>
          </div>

          <!-- Açıklama -->
          <div class="col-12">
            <label class="form-label">Açıklama</label>
            <textarea name="aciklama" class="form-control" rows="2"><%= org ? (org.aciklama||'') : '' %></textarea>
          </div>

          <!-- Slug bilgisi (düzenlemede) -->
          <% if (org && org.slug) { %>
          <div class="col-12">
            <label class="form-label">Slug (Otomatik)</label>
            <input type="text" class="form-control font-monospace" readonly value="<%= org.slug %>">
            <small class="text-muted">Slug değiştirilemez.</small>
          </div>
          <% } %>

        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary">
            <i class="fas fa-save me-1"></i><%= org ? 'Güncelle' : 'Kaydet' %>
          </button>
          <a href="<%= org ? '/organizasyon/' + org._id : '/organizasyon' %>" class="btn btn-outline-secondary">İptal</a>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>

<script>
const kademeSec   = document.getElementById('kademeSec');
const ustSec      = document.getElementById('ustSec');
const merkezIlSec = document.getElementById('merkezIlSec');

const zorunluKademeler = ['il_bolge', 'ake', 'alt_birim'];
const oncekiUst = '<%= seciliUst || "" %>';

function merkezIlGuncelle(kademe) {
  if (!merkezIlSec) return;
  const zorunlu = zorunluKademeler.includes(kademe);
  merkezIlSec.required = zorunlu;
  const label = merkezIlSec.closest('.col-md-6').querySelector('label');
  const yildiz = label.querySelector('.zorunlu-yildiz');
  if (zorunlu && !yildiz) {
    const s = document.createElement('span');
    s.className = 'text-danger zorunlu-yildiz';
    s.textContent = ' *';
    label.appendChild(s);
  } else if (!zorunlu && yildiz) {
    yildiz.remove();
  }
}

if (kademeSec) {
  kademeSec.addEventListener('change', async function() {
    const kademe = this.value;

    merkezIlGuncelle(kademe);

    // Bakanlık → üst birim yok
    if (!kademe || kademe === 'bakanlik') {
      ustSec.innerHTML = '<option value="">— Yok —</option>';
      ustSec.required  = false;
      return;
    }

    ustSec.innerHTML = '<option value="">Yükleniyor...</option>';
    ustSec.required  = true;

    try {
      const r    = await fetch('/organizasyon/api/ustlar/' + kademe);
      const list = await r.json();
      let opts   = '<option value="">— Seçin —</option>';
      list.forEach(u => {
        let label = u.ad;
        if (u.merkezIl) label += ' (' + u.merkezIl + ')';
        if (u.slug)     label += ' [' + u.slug + ']';
        const sel = oncekiUst && oncekiUst === u._id ? ' selected' : '';
        opts += `<option value="${u._id}"${sel}>${label}</option>`;
      });
      ustSec.innerHTML = opts;
    } catch(e) {
      ustSec.innerHTML = '<option value="">Hata — yeniden deneyin</option>';
    }
  });

  // Sayfa açılışında kademe zaten seçiliyse: üst listesi sunucudan geldi,
  // sadece required ve merkezIl durumunu güncelle
  if (kademeSec.value) merkezIlGuncelle(kademeSec.value);
}
</script>
