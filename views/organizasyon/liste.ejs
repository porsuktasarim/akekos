<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<div id="main">
  <%- include('../partials/topbar') %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <div class="d-flex justify-content-between align-items-center mb-3">
      <p class="text-muted mb-0 small">Ağaç görünümü — kademe sırasıyla</p>
      <a href="/organizasyon/yeni" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i>Yeni Kayıt
      </a>
    </div>

    <div class="card p-3">
      <% if (!agac.length) { %>
        <div class="text-center text-muted py-4">
          <i class="fas fa-sitemap fa-2x mb-2 d-block opacity-25"></i>
          Henüz kayıt yok. Önce bir Bakanlık ekleyin.
        </div>
      <% } else { %>
        <ul class="org-tree list-unstyled mb-0">
          <%- include('./partial_agac', { nodes: agac, depth: 0 }) %>
        </ul>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
