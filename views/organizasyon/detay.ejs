<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<div id="main">
  <%- include('../partials/topbar') %>
  <div class="content">
    <%- include('../partials/alerts') %>

    <div class="d-flex gap-2 mb-3">
      <a href="/organizasyon" class="btn btn-sm btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Geri</a>
      <a href="/organizasyon/<%= kayit._id %>/duzenle" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen me-1"></i>Düzenle</a>
      <form action="/organizasyon/<%= kayit._id %>?_method=DELETE" method="POST" class="d-inline"
            onsubmit="return confirm('Silmek istediğinizden emin misiniz?')">
        <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>Sil</button>
      </form>
    </div>

    <div class="card p-4" style="max-width:600px">
      <h5 class="mb-3"><%= kayit.ad %> <span class="badge <%= kayit.aktif ? 'badge-aktif' : 'badge-pasif' %> ms-2"><%= kayit.aktif ? 'Aktif' : 'Pasif' %></span></h5>
      <dl class="row mb-0">
        <dt class="col-sm-4">Kod</dt>        <dd class="col-sm-8"><%= kayit.kod || '—' %></dd>
        <dt class="col-sm-4">Tür</dt>        <dd class="col-sm-8"><%= kayit.tur %></dd>
        <dt class="col-sm-4">İl / İlçe</dt> <dd class="col-sm-8"><%= [kayit.il, kayit.ilce].filter(Boolean).join(' / ') || '—' %></dd>
        <dt class="col-sm-4">Adres</dt>      <dd class="col-sm-8"><%= kayit.adres || '—' %></dd>
        <dt class="col-sm-4">Telefon</dt>    <dd class="col-sm-8"><%= kayit.telefon || '—' %></dd>
        <dt class="col-sm-4">E-posta</dt>    <dd class="col-sm-8"><%= kayit.email || '—' %></dd>
        <dt class="col-sm-4">Açıklama</dt>  <dd class="col-sm-8"><%= kayit.aciklama || '—' %></dd>
      </dl>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
