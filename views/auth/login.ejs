<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Giriş — <%= appName %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <style>
    body { background: #2c3e50; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-card { width: 360px; }
  </style>
</head>
<body>
<div class="login-card">
  <div class="card shadow-lg border-0">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <i class="fas fa-shield-halved fa-3x text-primary mb-2"></i>
        <h4 class="fw-bold"><%= appName %></h4>
        <p class="text-muted small">Arama Kurtarma Ekipman Kontrol</p>
      </div>
      <% if (locals.hata && hata.length) { %>
        <div class="alert alert-danger py-2 small"><%= hata[0] %></div>
      <% } %>
      <form method="post" action="/login">
        <div class="mb-4">
          <label class="form-label">Kullanıcı Adı</label>
          <input type="text" name="kullanici" class="form-control" autofocus required>
          <div class="form-text text-muted">Geliştirme aşaması — şifre yok.</div>
        </div>
        <button type="submit" class="btn btn-primary w-100">
          <i class="fas fa-sign-in-alt me-1"></i>Giriş Yap
        </button>
      </form>
    </div>
  </div>
  <p class="text-center text-white-50 small mt-3"><%= appName %> &copy; <%= yil %></p>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
